{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["vite/client"],
    "paths": {
      "@/components/ui/*": ["./registry/headway/ui/*"],
      "@/lib/*": ["./registry/headway/lib/*"],
      "@/hooks/*": ["./registry/headway/hooks/*"],
      "@/docs/*": ["./src/*"]
    }
  },
  "include": ["src", "registry", "tests"]
}
